# ─── Server ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────
# Replace with your own connection string. The user/password are
# injected at deploy time via the host's secret manager; do NOT
# commit the real string to source control.
MONGO_URI=mongodb://localhost:27017/ai-hma

# ─── Auth ───────────────────────────────────────────────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-32-char-or-longer-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── AI / Gemini ────────────────────────────────────────────────────────
# Optional — without a key the AI service falls back to deterministic
# mock responses. Get your key at https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_VERSION=v1beta

# ─── Firebase (optional) ───────────────────────────────────────────────
# Only required for the /auth/sync Firebase-bridged login flow.
# The full service-account JSON, single-line, with literal \n in private_key.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"…","private_key":"-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n","client_email":"…"}

# ─── Rate limiting ─────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ─── Uploads ───────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FILES=5

# ─── CORS ───────────────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins. Useful for the
# deployed frontend URL.
CORS_EXTRA_ORIGINS=

# ─── MQTT (optional) ───────────────────────────────────────────────────
# MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_TOPIC=aihma/+/+/+
# MQTT_USERNAME=
# MQTT_PASSWORD=
