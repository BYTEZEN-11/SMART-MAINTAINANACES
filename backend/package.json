{
  "name": "ai-hma-backend",
  "version": "1.0.0",
  "description": "AI-powered home maintenance assistant backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "test": "npm run test:unit",
    "test:unit": "node __tests__/sanitize.test.js && node __tests__/aiService.test.js && node __tests__/validate.test.js && node __tests__/severity.test.js",
    "test:integration": "node __tests__/auth.test.js && node __tests__/iot-ownership.test.js && node __tests__/iot-race.test.js && node __tests__/pdf.test.js",
    "test:upgrade": "node __tests__/verify-upgrade.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:upgrade"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "home",
    "maintenance",
    "ai",
    "assistant"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "firebase-admin": "^12.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "mqtt": "^5.3.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.19.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
